# Tu API key de Google Gemini (NO compartas este archivo)
GEMINI_API_KEY=

# Modelo de audio en vivo de Gemini
# gemini-2.5-flash-native-audio-latest = Gemini 2.5 Flash Native Audio Dialog (API en vivo)
GEMINI_MODEL=

# Voz de respuesta (prebuilt voices: Aoede, Charon, Fenrir, Kore, Puck, Zephyr)
GEMINI_VOICE=

# Groq (para sugerencias de frases de texto, NO gasta la cuota de audio de Gemini)
GROQ_API_KEY=
GROQ_MODEL=

# Turso (LibSQL) - token temporal de prueba, rotar
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

AUTH_SECRET=
